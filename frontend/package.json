{
  "name": "dammaj-quran",
  "version": "1.0.0",
  "description": "دماج للقرآن الكريم - Professional Quran Video Studio",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"npm run dev:electron\" \"npm run dev:react\"",
    "dev:electron": "electron .",
    "dev:react": "react-scripts start",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "react-scripts build",
    "build:electron": "electron-builder",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,md}"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "electron-squirrel-startup": "^1.1.0",
    "zustand": "^4.4.1",
    "axios": "^1.6.2",
    "framer-motion": "^10.16.4",
    "react-hotkeys-hook": "^4.4.1",
    "react-virtualized": "^9.22.3",
    "tailwindcss": "^3.3.6",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-virtualized": "^9.21.29"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.3",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.dammaj.quran",
    "productName": "دماج للقرآن الكريم",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "quran",
    "video",
    "editor",
    "islamic",
    "arabic",
    "electron",
    "react"
  ],
  "author": {
    "name": "Dammaj Quran Team",
    "email": "dev@dammaj-quran.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mimotoufik11-stack/-dammaj-quran.git"
  },
  "license": "MIT"
}
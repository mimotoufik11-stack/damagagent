# Auto detect text files and normalize line endings
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.exe binary
*.dll binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Video files
*.mp4 binary
*.avi binary
*.mkv binary
*.mov binary
*.webm binary

# Audio files
*.mp3 binary
*.wav binary
*.ogg binary
*.aac binary

# Documents
*.pdf binary

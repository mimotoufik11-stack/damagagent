{
  "name": "dammaj-al-quran",
  "version": "1.0.0",
  "description": "Professional Quran Video Editing Studio with AI-Powered Transcription, Dubbing, and Subtitle Generation",
  "author": "Dammaj Al-Quran Team",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "webpack serve --config config/webpack.config.js --mode development",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "webpack --config config/webpack.config.js --mode production",
    "build:backend": "cd backend && pip install -r requirements.txt",
    "build:electron": "electron-builder",
    "build:docker": "docker-compose build",
    "setup:db": "python backend/scripts/setup-database.py",
    "download:models": "python backend/scripts/download-models.py",
    "lint": "eslint src/frontend --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist backend/__pycache__ backend/models"
  },
  "dependencies": {
    "@electron/remote": "^2.0.9",
    "axios": "^1.6.2",
    "classnames": "^2.3.2",
    "electron-is-dev": "^2.0.0",
    "framer-motion": "^10.16.16",
    "idb": "^7.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron/notarize": "^1.2.4",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.dammaj.alquran",
    "productName": "دماج للقرآن الكريم",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/frontend/renderer/assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/frontend/renderer/assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/frontend/renderer/assets/icons/icon.png"
    }
  }
}

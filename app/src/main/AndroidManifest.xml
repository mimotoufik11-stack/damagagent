<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AyahApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AyahCaptionEditor"
        tools:targetApi="31">
        
        <activity
            android:name=".ui.activity.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.AyahCaptionEditor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.ProjectsActivity"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:theme="@style/Theme.AyahCaptionEditor" />

        <activity
            android:name=".ui.activity.ImportActivity"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:theme="@style/Theme.AyahCaptionEditor" />

        <activity
            android:name=".ui.activity.ProcessingActivity"
            android:parentActivityName=".ui.activity.ImportActivity"
            android:theme="@style/Theme.AyahCaptionEditor"
            android:exported="false" />

        <activity
            android:name=".ui.activity.EditorActivity"
            android:parentActivityName=".ui.activity.ProjectsActivity"
            android:theme="@style/Theme.AyahCaptionEditor"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name=".ui.activity.ExportActivity"
            android:parentActivityName=".ui.activity.EditorActivity"
            android:theme="@style/Theme.AyahCaptionEditor"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>